{
  "name": "@shelf/jest-elasticsearch",
  "version": "6.0.0",
  "description": "Run Jest tests with a local Elasticsearch instance",
  "keywords": [
    "jest",
    "jest environment",
    "jest preset",
    "elasticsearch",
    "elasticsearch local",
    "elasticsearch-local"
  ],
  "repository": "shelfio/jest-elasticsearch",
  "license": "MIT",
  "author": {
    "name": "Andrii Petlovanyi",
    "email": "andrii.petlovanyi@shelf.io",
    "url": "shelf.io"
  },
  "files": [
    "jest-es-config.js",
    "jest-preset.js",
    "lib/"
  ],
  "scripts": {
    "build": "rm -rf lib/ && tsc --declaration",
    "coverage": "jest --coverage",
    "lint": "pnpm lint:ci --fix",
    "lint:ci": "eslint . --quiet",
    "prepack": "pnpm build",
    "test": "export ENVIRONMENT=local && jest tests",
    "type-check": "tsc --noEmit",
    "type-check:watch": "pnpm type-check -- --watch"
  },
  "packageManager": "pnpm@11.8.0",
  "prettier": "@shelf/prettier-config",
  "jest": {
    "preset": "./jest-preset.js",
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  },
  "dependencies": {
    "cwd": "0.10.0",
    "debug": "4.4.3",
    "download-tarball": "2.0.0",
    "execa": "8.0.1",
    "js-yaml": "4.1.1",
    "wait-for-localhost": "3.3.0"
  },
  "devDependencies": {
    "@elastic/elasticsearch": "8.4.0",
    "@shelf/eslint-config": "7.1.0",
    "@shelf/prettier-config": "0.0.7",
    "@shelf/tsconfig": "0.0.8",
    "@types/cwd": "^0.10.0",
    "@types/debug": "4.1.13",
    "@types/jest": "28.1.8",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22",
    "eslint": "10.8.0",
    "husky": "8.0.3",
    "jest": "28.1.3",
    "lint-staged": "13.3.0",
    "prettier": "3.5.3",
    "ts-jest": "28.0.8",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.{ts,js,}": [
      "eslint --fix"
    ],
    "*.{html,json,md,yml}": [
      "prettier --write"
    ]
  }
}
